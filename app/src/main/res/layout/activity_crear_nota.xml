<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://android.com/app"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        tools:context=".CrearNotaActivity">

    <!-- Título Principal -->
    <TextView
            android:id="@+id/tvCreateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Nota"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp" />

    <!-- Campo de Título de la Nota -->
    <EditText
            android:id="@+id/etTituloNota"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Título de la nota"
            android:inputType="textCapSentences"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="24dp" />

    <!-- Campo de Contenido (Caja grande de texto) -->
    <EditText
            android:id="@+id/etContenidoNota"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:hint="Escribe el contenido aquí..."
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:background="@android:drawable/edit_text"
            android:padding="16dp"
            android:layout_marginTop="16dp" />

    <!-- Botón Guardar -->
    <Button
            android:id="@+id/btnGuardarNota"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Guardar Nota"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

    <!-- Indicador de Carga -->
    <ProgressBar
            android:id="@+id/progressCrear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            tools:visibility="visible" />

</LinearLayout>